# Copy this to Config/local.env and fill in your own values.
# That file is gitignored, so nothing machine-specific reaches the repo.
#
# Find every UDID with:  xcrun devicectl list devices

# Your Vision Pro — used by `./Tools/build.sh vision`
RADIALMENU_DEVICE=

# Your iPhone — used by `./Tools/build.sh phone`
RADIALMENU_IPHONE=

# Your iPad — used by `./Tools/build.sh pad`
RADIALMENU_IPAD=

# Optional: which simulators the simulator targets should use. The name must
# match `xcrun simctl list devices available` exactly — and the model suffix
# moves with Xcode, so what was (M4) last year is (M5) now.
# RADIALMENU_SIM="Apple Vision Pro"
# RADIALMENU_IOS_SIM="iPhone 17 Pro Max"
# RADIALMENU_IPAD_SIM="iPad Pro 13-inch (M5)"

# Optional: pin the RUNTIME too, so testing does not drift ahead of the devices
# you actually own. Matched as a substring of the runtime header that
# `xcrun simctl list devices available` prints, e.g. "iOS 26.5", "visionOS 27".
# Unset means newest installed.
# RADIALMENU_IOS_RUNTIME="iOS 26.5"
# RADIALMENU_XR_RUNTIME="visionOS 26.5"
