# Copy this to Config/local.env and fill in your own values.
# That file is gitignored, so nothing machine-specific reaches the repo.
#
# Find every UDID with:  xcrun devicectl list devices

# Your Vision Pro — used by `./Tools/build.sh vision`
RADIALMENU_DEVICE=

# Your iPhone — used by `./Tools/build.sh phone`
RADIALMENU_IPHONE=

# Your iPad — used by `./Tools/build.sh pad`
RADIALMENU_IPAD=

# Optional: which simulators the simulator targets should use.
# RADIALMENU_SIM=Apple Vision Pro
# RADIALMENU_IOS_SIM=iPhone 17 Pro
# RADIALMENU_IPAD_SIM=iPad Pro 13-inch (M4)
